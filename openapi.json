    "/api/v1/meters/nearby": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Find smart meters near GPS coordinates",
        "description": "Perform a geospatial proximity search using the Haversine formula to find meters within a given radius.",
        "operationId": "find_nearby_meters_api_v1_meters_nearby_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Latitude of target origin coordinate",
              "title": "Lat"
            },
            "description": "Latitude of target origin coordinate",
            "example": 26.9389
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "description": "Longitude of target origin coordinate",
              "title": "Lng"
            },
            "description": "Longitude of target origin coordinate",
            "example": 75.8309
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 100.0,
              "minimum": 0.1,
              "description": "Search radius in kilometers",
              "default": 5.0,
              "title": "Radius Km"
            },
            "description": "Search radius in kilometers",
            "example": 5.0
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of nearby meters to return",
              "default": 20,
              "title": "Limit"
            },
            "description": "Maximum number of nearby meters to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeterNearbyItem"
                  },
                  "title": "Response Find Nearby Meters Api V1 Meters Nearby Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
