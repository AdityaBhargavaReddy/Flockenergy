    "/api/v1/meters/{meter_id}/readings": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get timeseries consumption readings and power metrics",
        "description": "Retrieve 30-minute interval readings for a meter with calculated interval consumption delta (kWh), power factor, and voltage metrics.",
        "operationId": "get_meter_readings_api_v1_meters__meter_id__readings_get",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Meter Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 1000,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Limit the number of interval readings returned",
              "title": "Limit"
            },
            "description": "Limit the number of interval readings returned"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(asc|desc)$",
              "description": "Sort order by timestamp: 'asc' (oldest first) or 'desc' (newest first)",
              "default": "asc",
              "title": "Order"
            },
            "description": "Sort order by timestamp: 'asc' (oldest first) or 'desc' (newest first)"
          }
        ],
        "responses": {
          "200": {
